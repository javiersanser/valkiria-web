---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog" description="Thoughts on AI agents, agentic companies, and building the future of work. From the Valkiria Lab team.">
  <section class="blog-index">
    <div class="blog-index-inner">
      <div class="section-header">
        <span class="section-tag">Blog</span>
        <h1 class="section-title">Thoughts on the<br><span class="gradient-text">agentic future</span>.</h1>
        <p class="section-desc">Building in public. Sharing what we learn about AI agents, agentic companies, and the future of work.</p>
      </div>

      <div class="posts-grid">
        {sortedPosts.map((post) => {
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          return (
            <a href={`/blog/${post.id}`} class="post-card">
              <div class="post-card-meta">
                <span class="post-card-date">{formattedDate}</span>
                {post.data.tags.length > 0 && (
                  <span class="post-card-tag">{post.data.tags[0]}</span>
                )}
              </div>
              <h2 class="post-card-title">{post.data.title}</h2>
              <p class="post-card-desc">{post.data.description}</p>
              <span class="post-card-link">
                Read more
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          );
        })}
      </div>

      {sortedPosts.length === 0 && (
        <div class="empty-state">
          <p>No posts yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index {
    min-height: 100vh;
    padding: 8rem 2rem 4rem;
  }

  .blog-index-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: 'Michroma', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--brand-purple);
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    font-family: 'Michroma', sans-serif;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .gradient-text {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-desc {
    color: rgba(255,255,255,0.45);
    font-size: 1.05rem;
    max-width: 50ch;
    margin: 0 auto;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-card {
    display: block;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 1.75rem;
    transition: all 0.3s;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(168,85,247,0.05) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .post-card:hover {
    border-color: rgba(168,85,247,0.3);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.3);
  }

  .post-card:hover::before {
    opacity: 1;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .post-card-date {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
  }

  .post-card-tag {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-purple);
    background: rgba(120, 63, 228, 0.12);
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
  }

  .post-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    font-family: 'Michroma', sans-serif;
    color: #fff;
    margin-bottom: 0.6rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .post-card-desc {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .post-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand-blue);
    transition: color 0.2s;
  }

  .post-card:hover .post-card-link {
    color: var(--brand-cyan);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: rgba(255,255,255,0.4);
  }
</style>
