---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog" description="Thoughts on AI agents, agentic companies, and building the future of work. From the Valkiria Lab team.">
  <section class="blog-index">
    <div class="blog-index-inner">
      <SectionHeader
        tag="Blog"
        title={'Thoughts on the<br><span class="gradient-text">agentic future</span>.'}
        desc="Building in public. Sharing what we learn about AI agents, agentic companies, and the future of work."
        level={1}
      />

      <div class="posts-grid">
        {sortedPosts.map((post) => {
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          return (
            <PostCard
              href={`/blog/${post.id}`}
              date={formattedDate}
              tag={post.data.tags[0]}
              title={post.data.title}
              description={post.data.description}
            />
          );
        })}
      </div>

      {sortedPosts.length === 0 && (
        <div class="empty-state">
          <p>No posts yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index {
    min-height: 100vh;
    padding: 8rem 2rem 4rem;
  }

  .blog-index-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: rgba(255,255,255,0.4);
  }
</style>
