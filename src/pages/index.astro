---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valkiria Lab — Building what comes next</title>
    <meta name="description" content="AI Agents as first-class workers. We build the infrastructure for agentic companies — Workspace, Bridge, and specialized agents that ship real work.">
    <link rel="canonical" href="https://valkirialab.com/">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://valkirialab.com/">
    <meta property="og:title" content="Valkiria Lab — The next generation of your workforce is digital">
    <meta property="og:description" content="AI Agents as first-class workers. We build the infrastructure for agentic companies — Workspace, Bridge, and specialized agents that ship real work.">
    <meta property="og:image" content="https://valkirialab.com/og-image.png">
    <meta property="og:site_name" content="Valkiria Lab">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Valkiria Lab — The next generation of your workforce is digital">
    <meta name="twitter:description" content="AI Agents as first-class workers. We build the infrastructure for agentic companies — Workspace, Bridge, and specialized agents that ship real work.">
    <meta name="twitter:image" content="https://valkirialab.com/og-image.png">

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Valkiria Lab",
      "url": "https://valkirialab.com",
      "logo": "https://valkirialab.com/branding/logotipo-valkiria-lab-horizontal-gradient-dark.svg",
      "description": "AI Agents as first-class workers. We build the infrastructure for agentic companies.",
      "sameAs": []
    }
    </script>

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Michroma&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Ambient background -->
    <div class="bg-grid"></div>
    <div class="bg-glow"></div>

    <!-- Header -->
    <header class="header">
        <div class="header-inner">
            <a href="/" class="logo">
                <img src="/branding/logotipo-valkiria-lab-horizontal-gradient-dark.svg" alt="Valkiria Lab" height="28">
            </a>
            <nav class="nav">
                <a href="/blog">Blog</a>
                <a href="#projects">Projects</a>
                <a href="#about">About</a>
                <a href="#contact" class="nav-cta">Contact</a>
            </nav>
        </div>
    </header>

    <main>
        <!-- Hero -->
        <section class="hero">
            <div class="hero-badge">
                <span class="badge-dot"></span>
                Now deploying AI-native companies
            </div>
            <h1 class="hero-title">
                <span class="gradient-text">The next generation</span><br>
                of your workforce<br>
                is digital.
            </h1>
            <p class="hero-sub">
                AI Agents as first class workers is the future.<br>
                We're building that future. Let's connect.
            </p>
            <div class="hero-actions">
                <a href="#projects" class="btn btn-primary">
                    See our work
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
                <a href="#contact" class="btn btn-ghost">Get in touch</a>
            </div>
            <div class="hero-stats">
                <div class="stat">
                    <span class="stat-num">3</span>
                    <span class="stat-label">Products building</span>
                </div>
                <div class="stat-div"></div>
                <div class="stat">
                    <span class="stat-num">2026</span>
                    <span class="stat-label">Founded</span>
                </div>
                <div class="stat-div"></div>
                <div class="stat">
                    <span class="stat-num">AI</span>
                    <span class="stat-label">Focus</span>
                </div>
            </div>
        </section>

        <!-- Marquee -->
        <section class="marquee-section">
            <div class="marquee">
                <div class="marquee-track">
                    <span>Agentic Companies</span>
                    <span class="sep">◆</span>
                    <span>AI Workforce</span>
                    <span class="sep">◆</span>
                    <span>Workspace</span>
                    <span class="sep">◆</span>
                    <span>Human + AI Teams</span>
                    <span class="sep">◆</span>
                    <span>Autonomous Execution</span>
                    <span class="sep">◆</span>
                    <span>Task Orchestration</span>
                    <span class="sep">◆</span>
                    <span>Agentic Companies</span>
                    <span class="sep">◆</span>
                    <span>AI Workforce</span>
                    <span class="sep">◆</span>
                    <span>Workspace</span>
                    <span class="sep">◆</span>
                    <span>Human + AI Teams</span>
                    <span class="sep">◆</span>
                    <span>Autonomous Execution</span>
                    <span class="sep">◆</span>
                    <span>Task Orchestration</span>
                    <span class="sep">◆</span>
                </div>
            </div>
        </section>

        <!-- Projects -->
        <section class="projects" id="projects">
            <div class="section-header">
                <span class="section-tag">Portfolio</span>
                <h2 class="section-title">Our Projects</h2>
                <p class="section-desc">AI-native products built with market focus and technical excellence.</p>
            </div>
            <div class="projects-grid">
                <article class="project-card">
                    <div class="project-card-top">
                        <div class="project-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="3" y="3" width="8" height="8" rx="2" stroke="var(--brand-purple)" stroke-width="1.5"/>
                                <rect x="13" y="3" width="8" height="8" rx="2" stroke="var(--brand-purple)" stroke-width="1.5"/>
                                <rect x="3" y="13" width="8" height="8" rx="2" stroke="var(--brand-purple)" stroke-width="1.5"/>
                                <rect x="13" y="13" width="8" height="8" rx="2" stroke="var(--brand-blue)" stroke-width="1.5"/>
                            </svg>
                        </div>
                        <span class="project-status project-status-dev">Beta</span>
                    </div>
                    <h3 class="project-name">Valkiria Workspace</h3>
                    <p class="project-desc">The AI-native company operating system. Manage humans and AI agents as a unified team — roles, tasks, goals, and real-time status in one place. Already running real teams, including our own.</p>
                    <div class="project-tags">
                        <span>Workspace</span>
                        <span>AI Agents</span>
                        <span>SaaS</span>
                    </div>
                    <a href="#contact" class="project-link">
                        Book a demo
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                </article>

                <article class="project-card">
                    <div class="project-card-top">
                        <div class="project-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="5" cy="12" r="2.5" stroke="var(--brand-blue)" stroke-width="1.5"/>
                                <circle cx="19" cy="12" r="2.5" stroke="var(--brand-blue)" stroke-width="1.5"/>
                                <path d="M7.5 12h9" stroke="var(--brand-blue)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="2 2"/>
                                <path d="M5 6V4M5 20v-2M19 6V4M19 20v-2" stroke="var(--brand-blue)" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <span class="project-status">Live</span>
                    </div>
                    <h3 class="project-name">Valkiria Bridge</h3>
                    <p class="project-desc">Connect any agent — Claude, Codex, Gemini, Pi — to your workspace with a single command. Real-time, self-updating, runs anywhere.</p>
                    <div class="project-tags">
                        <span>Infrastructure</span>
                        <span>Protocol</span>
                        <span>Agents</span>
                    </div>
                    <a href="#contact" class="project-link">
                        Talk to us
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                </article>

                <article class="project-card">
                    <div class="project-card-top">
                        <div class="project-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="8" r="3.5" stroke="var(--brand-cyan)" stroke-width="1.5"/>
                                <path d="M5 20c0-3.5 3-5.5 7-5.5s7 2 7 5.5" stroke="var(--brand-cyan)" stroke-width="1.5" stroke-linecap="round"/>
                                <path d="M17 3l1.5 1.5L17 6" stroke="var(--brand-cyan)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <span class="project-status project-status-dev">In progress</span>
                    </div>
                    <h3 class="project-name">Valkiria Agents</h3>
                    <p class="project-desc">Spin up a specialized AI agent into a role — managed, containerized and auto-updating. Out of the box, ready to work. Zero infrastructure on your side.</p>
                    <div class="project-tags">
                        <span>AI Agents</span>
                        <span>Plug & Play</span>
                        <span>Automation</span>
                    </div>
                    <a href="#contact" class="project-link">
                        Join the Beta
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                </article>
            </div>
        </section>

        <!-- Valkiria runs on Valkiria -->
        <section class="dogfood" id="how-we-work">
            <div class="section-header">
                <span class="section-tag">Proof</span>
                <h2 class="section-title">Valkiria runs on Valkiria.</h2>
                <p class="section-desc">We don't just build the AI-native company stack — we run on it. From day one, our own company operates as a human + AI team, using the very products we ship.</p>
            </div>
            <div class="dogfood-grid">
                <div class="dogfood-item">
                    <span class="dogfood-num">01</span>
                    <h3>Agents with real roles</h3>
                    <p>A senior architect, a developer, an operations lead — AI agents holding actual positions on the team, not assistants on the side.</p>
                </div>
                <div class="dogfood-item">
                    <span class="dogfood-num">02</span>
                    <h3>They ship real work</h3>
                    <p>Our agents claim tasks, write code, open and review pull requests, and merge — coordinated through Workspace and Bridge, every day.</p>
                </div>
                <div class="dogfood-item">
                    <span class="dogfood-num">03</span>
                    <h3>The loop compounds</h3>
                    <p>The products build the company that builds the products. Everything we improve, our own team uses the next day.</p>
                </div>
            </div>
        </section>

        <!-- About -->
        <section class="about" id="about">
            <div class="about-grid">
                <div class="about-text">
                    <span class="section-tag">About us</span>
                    <h2 class="section-title">Built for the next wave<br>of AI companies.</h2>
                    <p class="about-body">
                        We don't just build software — we build a new kind of company. One where AI agents are first-class team members: they have roles, receive tasks, report status, and scale with the business.
                    </p>
                    <p class="about-body">
                        We're deploying this model ourselves, from day one — and building the infrastructure to let anyone do the same.
                    </p>
                    <div class="about-values">
                        <div class="value">
                            <span class="value-num">01</span>
                            <span class="value-text">Agents as first-class workers, not tools</span>
                        </div>
                        <div class="value">
                            <span class="value-num">02</span>
                            <span class="value-text">Ship fast, validate with the market</span>
                        </div>
                        <div class="value">
                            <span class="value-num">03</span>
                            <span class="value-text">Infrastructure that eats complexity</span>
                        </div>
                    </div>
                </div>
                <div class="about-visual">
                    <div class="vision-card">
                        <div class="vision-card-inner">
                            <span class="vision-label">Our Vision</span>
                            <p class="vision-text">The AI-native company operating system — where humans and agents work as a unified team, from day one.</p>
                        </div>
                    </div>
                    <div class="vision-card vision-card-2">
                        <div class="vision-card-inner">
                            <span class="vision-label">Our Approach</span>
                            <p class="vision-text">Deploy agents → Assign work → Ship faster → Repeat.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact -->
        <section class="contact" id="contact">
            <div class="contact-inner">
                <span class="section-tag">Contact</span>
                <h2 class="contact-title">Let's build something<br><span class="gradient-text">remarkable</span>.</h2>
                <p class="contact-sub">Interested in collaborating, investing, or joining our ecosystem? We'd love to hear from you.</p>
                <a href="mailto:hola@valkirialab.com" class="contact-email">
                    hola@valkirialab.com
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-left">
                <a href="/" class="logo footer-logo">
                    <img src="/branding/logotipo-valkiria-lab-horizontal-white-dark.svg" alt="Valkiria Lab" height="24">
                </a>
                <p class="footer-tagline">Building what comes next.</p>
            </div>
            <div class="footer-links">
                <div class="footer-col">
                    <span class="footer-col-title">Products</span>
                    <a href="https://workspace.valkirialab.com" target="_blank">Workspace</a>
                    <a href="https://valkirialab.com#projects">Bridge</a>
                    <a href="https://valkirialab.com#projects">Agents</a>
                </div>
                <div class="footer-col">
                    <span class="footer-col-title">Company</span>
                    <a href="#about">About</a>
                    <a href="#contact">Contact</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 Valkiria Lab. All rights reserved.</span>
        </div>
    </footer>
</body>
</html>

<style is:global>
    *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: #050507;
        color: #e2e8f0;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
    }

    ::selection {
        background: var(--border-brand-violet);
        color: #fff;
    }

    ::-webkit-scrollbar {
        width: 6px;
    }
    ::-webkit-scrollbar-track {
        background: #0a0a0f;
    }
    ::-webkit-scrollbar-thumb {
        background: #2d2d3a;
        border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #3d3d4a;
    }
</style>

<style>
    /* Background */
    .bg-grid {
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 60px 60px;
        pointer-events: none;
        z-index: 0;
    }

    .bg-glow {
        position: fixed;
        top: -400px;
        left: 50%;
        transform: translateX(-50%);
        width: 800px;
        height: 800px;
        background: radial-gradient(ellipse at center,
                var(--glow-brand-purple) 0%,
                var(--glow-brand-blue) 40%,
                transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    /* Header */
    .header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        backdrop-filter: blur(12px);
        background: rgba(5, 5, 7, 0.8);
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .header-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        color: #fff;
    }

    .logo img {
        height: 36px;
        width: auto;
    }

    .footer-logo img {
        height: 30px;
    }

    .nav {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .nav a {
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: color 0.2s;
    }

    .nav a:hover {
        color: #fff;
    }

    .nav-cta {
        background: var(--surface-brand-violet);
        border: 1px solid var(--border-brand-violet);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        color: var(--brand-purple) !important;
        transition: all 0.2s !important;
    }

    .nav-cta:hover {
        background: var(--surface-brand-violet-hover) !important;
        border-color: var(--border-brand-violet-strong) !important;
    }

    main {
        position: relative;
        z-index: 1;
    }

    /* Hero */
    .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 8rem 2rem 4rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--surface-brand-violet-soft);
        border: 1px solid var(--border-brand-violet-soft);
        padding: 0.4rem 0.9rem;
        border-radius: 100px;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--brand-purple);
        margin-bottom: 2rem;
        width: fit-content;
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--brand-purple);
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    .hero-title {
        font-size: clamp(3rem, 8vw, 6rem);
        font-weight: 800;
        font-family: 'Michroma', sans-serif;
        line-height: 1.05;
        letter-spacing: -0.02em;
        color: #fff;
        margin-bottom: 1.5rem;
    }

    .gradient-text {
        background: var(--gradient-brand);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-sub {
        font-size: clamp(1rem, 2vw, 1.25rem);
        color: rgba(255,255,255,0.5);
        max-width: 55ch;
        line-height: 1.7;
        margin-bottom: 2.5rem;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        margin-bottom: 4rem;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        cursor: pointer;
    }

    .btn-primary {
        background: var(--gradient-brand-short);
        color: #fff;
        box-shadow: 0 0 30px var(--glow-brand-violet);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 40px var(--border-brand-violet-strong);
    }

    .btn-ghost {
        background: transparent;
        color: rgba(255,255,255,0.7);
        border: 1px solid rgba(255,255,255,0.15);
    }

    .btn-ghost:hover {
        background: rgba(255,255,255,0.05);
        color: #fff;
        border-color: rgba(255,255,255,0.3);
    }

    .hero-stats {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .stat-num {
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.02em;
    }

    .stat-label {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.4);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .stat-div {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.1);
    }

    /* Marquee */
    .marquee-section {
        border-top: 1px solid rgba(255,255,255,0.06);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding: 1.2rem 0;
        overflow: hidden;
    }

    .marquee {
        display: flex;
        overflow: hidden;
        user-select: none;
    }

    .marquee-track {
        display: flex;
        align-items: center;
        gap: 2rem;
        animation: marquee 30s linear infinite;
        white-space: nowrap;
    }

    .marquee-track span {
        font-size: 0.85rem;
        font-weight: 500;
        color: rgba(255,255,255,0.35);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .marquee-track .sep {
        color: var(--text-brand-violet-muted);
        font-size: 0.5rem;
    }

    @keyframes marquee {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    /* Sections */
    .section-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .section-tag {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        font-family: 'Michroma', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--brand-purple);
        margin-bottom: 1rem;
    }

    .section-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        font-family: 'Michroma', sans-serif;
        color: #fff;
        letter-spacing: -0.02em;
        line-height: 1.15;
        margin-bottom: 1rem;
    }

    .section-desc {
        color: rgba(255,255,255,0.45);
        font-size: 1.05rem;
        max-width: 50ch;
