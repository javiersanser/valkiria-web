---
interface Props {
  href: string;
  date: string;
  tag?: string;
  title: string;
  description: string;
}

const { href, date, tag, title, description } = Astro.props;
---

<a href={href} class="post-card">
  <div class="post-card-meta">
    <span class="post-card-date">{date}</span>
    {tag && (
      <span class="post-card-tag">{tag}</span>
    )}
  </div>
  <h2 class="post-card-title">{title}</h2>
  <p class="post-card-desc">{description}</p>
  <span class="post-card-link">
    Read more
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</a>

<style>
  .post-card {
    display: block;
    background: var(--surface-card);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 1.75rem;
    transition: all 0.3s;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--surface-brand-violet-subtle) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .post-card:hover {
    border-color: var(--border-brand-violet);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.3);
  }

  .post-card:hover::before {
    opacity: 1;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .post-card-date {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
  }

  .post-card-tag {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-purple);
    background: var(--surface-brand-purple-soft);
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
  }

  .post-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    font-family: 'Michroma', sans-serif;
    color: #fff;
    margin-bottom: 0.6rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .post-card-desc {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .post-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand-blue);
    transition: color 0.2s;
  }

  .post-card:hover .post-card-link {
    color: var(--brand-cyan);
  }
</style>
